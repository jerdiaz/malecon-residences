# En el VPS va como `.env` en la carpeta de la app; en local, como `.env.local`.
# Los dos están en .gitignore. Cómo obtener cada valor: REGISTRO-GOOGLE-SHEET.md.

# Registro de la puerta de entrada → Google Sheets (src/app/api/registro/route.ts).
# Sin estas dos variables, en desarrollo los registros se imprimen en la consola
# del servidor; en producción se escriben en el log de PM2 y el visitante entra
# igual.

# JSON de la cuenta de servicio de Google, en UNA sola línea. Es el mismo que
# usa tooli-chatbot: copiar tal cual de su .env.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ID de la hoja: el tramo largo de su URL, entre /d/ y /edit.
REGISTRO_SHEET_ID=

# Clave del enlace "Acceso interno" al pie de la puerta (src/app/api/acceso/route.ts):
# con ella la administración entra sin registrarse. Cualquier texto; se comparte
# solo con el equipo. Cambiarla es editar esta línea y `pm2 restart malecon`.
ACCESO_EQUIPO_CLAVE=
